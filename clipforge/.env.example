# Copy to .env and edit. Everything is optional; the app runs with heuristics only when no key is set.

# Anthropic API key for LLM scoring + copywriting (optional)
ANTHROPIC_API_KEY=
# Model used for scoring/copy when a key is present
CLIPFORGE_LLM_MODEL=claude-sonnet-5-5

# faster-whisper model size: tiny | base | small | medium | large-v3
CLIPFORGE_WHISPER_MODEL=small
# cpu | cuda | auto
CLIPFORGE_WHISPER_DEVICE=auto
# int8 | int8_float16 | float16 | float32
CLIPFORGE_WHISPER_COMPUTE=int8

# Where jobs are stored (default ./jobs)
CLIPFORGE_JOBS_DIR=./jobs
# SQLite database file (default ./jobs/clipforge.db)
CLIPFORGE_DB_PATH=
# Delete jobs older than this many days when running cleanup (default 14)
CLIPFORGE_RETENTION_DAYS=14
# Cap source download resolution
CLIPFORGE_MAX_DOWNLOAD_HEIGHT=1080

# Server bind
CLIPFORGE_HOST=127.0.0.1
CLIPFORGE_PORT=8000

# Your local timezone for the posting schedule (IANA name)
CLIPFORGE_TIMEZONE=America/Los_Angeles
