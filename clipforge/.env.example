# Copy to .env and edit. Everything is optional; the app runs with heuristics only when no key is set.

# Anthropic API key for LLM scoring + copywriting (optional)
ANTHROPIC_API_KEY=
# Model used for scoring/copy when a key is present
CLIPFORGE_LLM_MODEL=claude-opus-5-5
# Let the model run a few web searches per job to pull current trends for the video's niche (costs a little more)
CLIPFORGE_LLM_WEB_SEARCH=1
# Let the model fix transcript errors (names, jargon) before captions are burned in
CLIPFORGE_LLM_POLISH_SUBTITLES=1

# faster-whisper model size: tiny | base | small | medium | large-v3
CLIPFORGE_WHISPER_MODEL=small
# cpu | cuda | auto
CLIPFORGE_WHISPER_DEVICE=auto
# int8 | int8_float16 | float16 | float32
CLIPFORGE_WHISPER_COMPUTE=int8

# Where jobs are stored (default ./jobs)
CLIPFORGE_JOBS_DIR=./jobs
# SQLite database file (default ./jobs/clipforge.db)
CLIPFORGE_DB_PATH=
# Delete jobs older than this many days when running cleanup (default 14)
CLIPFORGE_RETENTION_DAYS=14
# Cap source download resolution
CLIPFORGE_MAX_DOWNLOAD_HEIGHT=1080

# Server bind
CLIPFORGE_HOST=127.0.0.1
CLIPFORGE_PORT=8000

# Your local timezone for the posting schedule (IANA name)
CLIPFORGE_TIMEZONE=America/Los_Angeles

# --- Exposing the app beyond this computer (phone on the same Wi-Fi, a VPS) ---
# Require a password on every page (HTTP Basic, any username). Set this BEFORE changing the host.
CLIPFORGE_PASSWORD=
# Listen on all interfaces so other devices can reach it (keep 127.0.0.1 for local-only use)
# CLIPFORGE_HOST=0.0.0.0

# --- Weak machines (Chromebooks, old laptops) ---
# 1 = whisper 'base', one universal file per clip, ultrafast encoding, max 4 clips, faster scene scan
CLIPFORGE_LOW_POWER=0
# Fine-grained overrides instead of LOW_POWER (platform|universal; ultrafast|veryfast|medium)
# CLIPFORGE_PLACEMENT=
# CLIPFORGE_RENDER_PRESET=
