---
import Base from "../layouts/Base.astro";
import VideoHero from "../components/VideoHero.astro";
import { SITE, SERVICES, REVIEWS, FULL_ADDRESS } from "../lib/site";

const faqs = [
  [
    "Do I need an appointment?",
    "Call first and we will tell you honestly whether we can look at it today. We are open Monday to Saturday, 8:00 to 5:00.",
  ],
  [
    "Will you tell me what it costs before you start?",
    "Yes. We diagnose the vehicle, explain what we found in plain language, and give you a price. Nothing gets repaired until you say so.",
  ],
  [
    "Do you work on diesel and fleet vehicles?",
    "Both. Diesel pickups and work trucks, and fleet vans on a maintenance schedule, alongside ordinary cars and SUVs.",
  ],
];

const schema = [
  {
    "@type": "FAQPage",
    mainEntity: faqs.map(([q, a]) => ({
      "@type": "Question",
      name: q,
      acceptedAnswer: { "@type": "Answer", text: a },
    })),
  },
];
---

<Base
  title="Auto Repair in Lodi, CA | Phil's Auto & Fleet Repair"
  description="Family-run auto, diesel and fleet repair in Lodi, CA. We diagnose before we replace parts, and quote before we start. Call (209) 647-4953."
  path="/"
  schema={schema}
>
  <VideoHero
    src="/media/hero.mp4"
    fallbackImage="/media/03-engine.jpg"
    fallbackAlt="An engine stripped down on the floor of Phil's Auto and Fleet Repair"
  />

  {/* ---- everything below the fold sits on solid ground ---- */}
  <div class="page">
    <section class="section">
      <div class="shell">
        <p class="eyebrow" data-reveal>What we do first</p>
        <h2 data-reveal>A code names a circuit. It does not name the part.</h2>
        <p data-reveal class="lead">
          The same misfire code can be a coil, a plug, an injector, a wiring fault, or
          compression that is quietly walking away. Four of those are cheap. One means
          the head comes off. So we test until we know which — before anything is
          ordered, and before you are asked to approve anything.
        </p>
        <div class="proof-row">
          <div data-reveal>
            <strong class="tnum">{SITE.rating}★</strong>
            <span>from {SITE.reviewCount} ratings</span>
          </div>
          <div data-reveal>
            <strong>Mon–Sat</strong>
            <span>8:00 to 5:00, six days</span>
          </div>
          <div data-reveal>
            <strong>Auto · Diesel · Fleet</strong>
            <span>One shop, all three</span>
          </div>
        </div>
      </div>
    </section>

    <section class="section alt">
      <div class="shell">
        <p class="eyebrow" data-reveal>What we repair</p>
        <h2 data-reveal>Cars, diesel trucks and fleet vans</h2>
        <ul class="cards">
          {SERVICES.map((s) => (
            <li data-reveal>
              <a href={`/services/${s.slug}/`} data-cursor="Open">
                <h3>{s.nav}</h3>
                <p>{s.blurb}</p>
                <span class="go" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="marquee-band" aria-label="Brands and memberships carried by the shop">
      <div class="marquee">
        <ul>{[...SITE.carries, ...SITE.carries].map((b) => <li>{b}</li>)}</ul>
      </div>
    </section>

    <section class="section">
      <div class="shell">
        <p class="eyebrow" data-reveal>The shop itself</p>
        <h2 data-reveal>103 E Elm Street, Lodi</h2>
        <p data-reveal>
          Two bays just east of downtown, minutes off Highway 99. Roll-up door open most
          of the day, and the number is on the wall if you would rather call first.
        </p>
        <div class="shop-frame" data-reveal>
          <img
            src="/media/02-bay.jpg"
            alt="Looking into the shop from the open bay door, a pickup on the floor and the parts shelving behind it"
            width="1284"
            height="1711"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </section>

    <section class="section alt">
      <div class="shell">
        <p class="eyebrow" data-reveal>In their words</p>
        <h2 data-reveal>What customers say</h2>
        <ul class="quotes">
          {REVIEWS.map((r) => (
            <li data-reveal>
              <blockquote><p>{r.quote}</p></blockquote>
              <figcaption><strong>{r.name}</strong> <span>· {r.source}</span></figcaption>
            </li>
          ))}
        </ul>
        <p data-reveal><a class="more" href="/reviews/">Read all the reviews</a></p>
      </div>
    </section>

    <section class="section" id="quote">
      <div class="shell">
        <div class="cta-block" data-reveal>
          <h2>Tell us what it is doing</h2>
          <p>
            Call and describe the noise, the light, or the quote you have been given. If
            we can point you somewhere better, we will say so.
          </p>
          <div class="cta-row">
            <a class="btn btn-primary phone" href={`tel:${SITE.phoneLink}`} data-magnetic>{SITE.phone}</a>
            <a class="btn btn-ghost" href="/contact/" data-magnetic>Send it in writing</a>
          </div>
          <p class="fine tnum">{FULL_ADDRESS} · {SITE.hoursHuman}</p>
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  /* Solid from here down — nothing below the fold is transparent, so the
     video never shows through the content. */
  .page { position: relative; z-index: 1; background: var(--color-ink); }
  .section { padding: clamp(4rem, 9vw, 7.5rem) 0; background: var(--color-ink); }
  .section.alt { background: #0b0b22; }

  .lead { font-size: clamp(1.02rem, 1.5vw, 1.18rem); margin-top: 1.4rem; }

  .proof-row {
    display: grid;
    gap: 1px;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    margin-top: 3rem;
    background: var(--color-line);
    border: 1px solid var(--color-line);
    border-radius: 14px;
    overflow: hidden;
  }
  .proof-row div { background: var(--color-surface); padding: 1.5rem; }
  .proof-row strong { display: block; font-size: 1.5rem; font-weight: 800; letter-spacing: -0.02em; }
  .proof-row span { color: var(--color-muted); font-size: 0.9rem; }

  .cards {
    list-style: none; margin: 2.5rem 0 0; padding: 0;
    display: grid; gap: 1px;
    grid-template-columns: repeat(auto-fit, minmax(255px, 1fr));
    background: var(--color-line);
    border: 1px solid var(--color-line);
    border-radius: 16px; overflow: hidden;
  }
  .cards a {
    display: block; padding: 1.6rem; height: 100%;
    background: var(--color-surface); text-decoration: none;
    position: relative; transition: background 0.25s;
  }
  .cards a:hover { background: #16163a; }
  .cards h3 { margin-bottom: 0.5rem; }
  .cards p { color: var(--color-muted); font-size: 0.93rem; margin: 0; }
  .cards .go {
    position: absolute; top: 1.6rem; right: 1.6rem;
    color: var(--color-brand-bright); opacity: 0;
    transition: opacity 0.25s, translate 0.25s;
  }
  .cards a:hover .go { opacity: 1; translate: 4px 0; }

  .marquee-band { border-block: 1px solid var(--color-line); padding: 1.4rem 0; background: #05050f; }
  .marquee li {
    font-weight: 800; font-size: 0.84rem; letter-spacing: 0.16em;
    text-transform: uppercase; color: #8a94ad; white-space: nowrap;
  }

  .shop-frame {
    margin-top: 2.5rem; border-radius: 18px; overflow: hidden;
    border: 1px solid var(--color-line); max-height: 68svh;
  }
  .shop-frame img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .quotes {
    list-style: none; margin: 2.5rem 0 2rem; padding: 0;
    display: grid; gap: 1.2rem;
    grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
  }
  .quotes li { padding: 1.7rem; border-radius: 14px; background: var(--color-surface); border: 1px solid var(--color-line); }
  .quotes blockquote { margin: 0; }
  .quotes p { font-size: 0.96rem; margin-bottom: 1rem; }
  .quotes figcaption { font-size: 0.85rem; color: var(--color-muted); }
  .quotes strong { color: var(--color-text); }
  .more { color: var(--color-brand-bright); font-weight: 700; }

  .cta-block {
    padding: clamp(2rem, 5vw, 3.5rem); border-radius: 20px;
    background: linear-gradient(150deg, #14123a, #0a0a22);
    border: 1px solid var(--color-line);
  }
  .cta-row { display: flex; gap: 0.9rem; flex-wrap: wrap; margin: 2rem 0 1.4rem; }
  .cta-block .fine { font-size: 0.85rem; color: var(--color-muted); margin: 0; }
</style>
