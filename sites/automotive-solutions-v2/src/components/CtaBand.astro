---
import data from '../data/site.json';
import Icon from './Icon.astro';
const S = data.site;
export interface Props { heading?: string; text?: string }
const {
  heading = 'Ready for a straight answer about your vehicle?',
  text = 'Call the shop and talk to someone who works on cars for a living. We are open Monday through Friday, 9:00 AM to 6:00 PM.',
} = Astro.props;
---
<section>
  <div class="wrap">
    <div class="cta-band">
      <div>
        <h2>{heading}</h2>
        <p>{text}</p>
      </div>
      <div class="btn-row">
        <a class="btn btn-accent" href={`tel:${S.phone_link}`} data-loc="cta-band">
          <Icon name="phone" /><span>Call {S.phone_display}</span>
        </a>
        <a class="btn btn-ghost" href="/contact/#quote">Request a quote</a>
      </div>
    </div>
  </div>
</section>
