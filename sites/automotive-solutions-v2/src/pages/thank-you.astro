---
import data from '../data/site.json';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';
const S = data.site;
---
<Base title="Thank You | Automotive Solutions"
  description="Your request has been sent to Automotive Solutions in Elk Grove, CA. We will call you back during shop hours."
  path="/thank-you/" noindex={true}>
  <PageHead trail={[['Home', '/'], ['Thank you', '/thank-you/']]}
    h1="Thanks — we've got your request"
    lede={`We will get back to you as soon as we can during shop hours (${S.hours_human}).`}>
    <div class="btn-row">
      <a class="btn btn-accent" href={`tel:${S.phone_link}`} data-loc="thanks">
        <Icon name="phone" /><span>Call {S.phone_display}</span>
      </a>
      <a class="btn btn-ghost" href="/">Back to home</a>
    </div>
  </PageHead>
  <section><div class="wrap narrow">
    <h2>What happens next</h2>
    <ol>
      <li>We read your request and check the details against what your vehicle is doing.</li>
      <li>We call you back to confirm the symptom and what a diagnosis would involve.</li>
      <li>We schedule you in and give you a realistic estimate of time and cost.</li>
    </ol>
    <p>If it is urgent — an overheating engine, brakes that do not feel right, a car that will not start — do not wait on the callback. Call <a href={`tel:${S.phone_link}`}>{S.phone_display}</a>.</p>
  </div></section>
</Base>
