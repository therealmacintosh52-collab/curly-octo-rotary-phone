---
import { icons } from '../lib/seo';
interface Props { name: string; class?: string }
const { name, class: cls = 'icon' } = Astro.props;
const path = icons[name];
if (!path) throw new Error(`Unknown icon: ${name}`);
---
<svg class={cls} viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={path} />
