---
/**
 * Scroll-driven tint reveal. The car (hero frame cropped by
 * scripts/compare-images.mjs with its glass brightened to read as clear) sits
 * under one overlay per pane of glass, each clipped to the polygon traced in
 * src/data/masks.json and remapped to the crop. Each overlay is a hard-edged
 * gradient whose edge is driven by --p, so the film visibly sweeps across the
 * glass like a squeegee pass as src/scripts/site.ts pins the section and
 * scrubs --p from 0 to 1. The readout counts 100% down to 5%, the bar fills,
 * the step cards light up in turn. Without JS, or with reduced motion, the
 * CSS default (--p: 1) shows the finished 5%.
 */
import data from '../data/site.json';
import masks from '../data/masks.json';
import Icon from './Icon.astro';
const S = data.site;
const T = S.tint_story;
const C = masks.story_crop;
const polys = masks.polygons as Record<string, [number, number][]>;
const pct = (pts: [number, number][]) =>
  pts.map(([x, y]) => `${(((x - C.left) / C.width) * 100).toFixed(2)}% ${(((y - C.top) / C.height) * 100).toFixed(2)}%`).join(', ');
const glass = masks.glass as string[];
---
<section class="story" data-tint-story style="--p:1">
  <div class="story__pin" data-story-pin>
    <div class="story__stage">
      <div class="story__view">
        <div class="story__car">
          <picture>
            <source srcset="/assets/img/tint-story.webp" type="image/webp" />
            <img src="/assets/img/tint-story.jpg" width={C.width} height={C.height} loading="lazy" decoding="async"
                 alt="The model car with every window going from clear glass to 5% film as the page scrolls" />
          </picture>
          {glass.map((name) => (
            <div class="story__glass" style={`clip-path: polygon(${pct(polys[name])})`} aria-hidden="true"></div>
          ))}
        </div>
        <span class="story__badge" aria-hidden="true"><span data-vlt>5</span>% VLT</span>
      </div>
      <div class="story__shade" aria-hidden="true"></div>
      <div class="story__copy">
        <div class="wrap">
          <div class="story__panel">
            <span class="eyebrow">{T.eyebrow}</span>
            <h2>{T.heading}</h2>
            <p>{T.text}</p>
            <div class="story__vlt" aria-live="off">
              <b><span data-vlt>5</span>%</b>
              <span>of the light through the glass</span>
            </div>
            <div class="story__bar" aria-hidden="true"><i></i><span>Film applied</span></div>
            <ol class="story__steps">
              {T.steps.map(([name, note], i) => (
                <li data-step={i} class={i === T.steps.length - 1 ? 'is-on' : undefined}>
                  <b>{name}</b><span>{note}</span>
                </li>
              ))}
            </ol>
            <div class="btn-row">
              <a class="btn btn-accent" href="/services/window-tinting/">Tint pricing <Icon name="arrow" /></a>
              <a class="btn btn-ghost" href="/advice/california-window-tint-law/">What's legal in California</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
