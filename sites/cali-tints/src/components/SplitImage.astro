---
/**
 * Static before | after image: one 2:1 picture whose left half is "before"
 * and right half "after", with our own labels and a centre line. Generated by
 * scripts/split-images.mjs from the owner's collage. No JS.
 */
export interface Props {
  src: string;          // path without extension; .jpg and .webp both exist
  alt: string;
  caption?: string;
  compact?: boolean;    // smaller labels for the three-up grid on the home page
}
const { src, alt, caption, compact = false } = Astro.props;
---
<figure class:list={['split-img', compact && 'split-img--compact']}>
  <div class="split-img__stage">
    <picture>
      <source srcset={`${src}.webp`} type="image/webp" />
      <img src={`${src}.jpg`} width="1280" height="640" loading="lazy" decoding="async" alt={alt} />
    </picture>
    <span class="split-img__line" aria-hidden="true"></span>
    <span class="split-img__label split-img__label--before" aria-hidden="true">Before</span>
    <span class="split-img__label split-img__label--after" aria-hidden="true">After</span>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
