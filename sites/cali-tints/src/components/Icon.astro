---
import data from '../data/site.json';
export interface Props { name: string; class?: string }
const { name, class: cls = 'icon' } = Astro.props;
const icons = data.icons as Record<string, string>;
const path = icons[name] ?? icons.check;
---
<svg class={cls} viewBox="0 0 24 24" aria-hidden="true" set:html={path} />
