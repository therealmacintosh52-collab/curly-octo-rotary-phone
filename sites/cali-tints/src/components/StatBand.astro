---
import data from '../data/site.json';
import Icon from './Icon.astro';
const S = data.site;
// A [string, string] tuple becomes a number that counts up when the band
// scrolls into view (src/scripts/site.ts), then its text.
type Cell = string | [string, string];
const stats: [string, Cell, Cell][] = [
  ['star',  [String(S.rating), ' out of 5'],       [String(S.review_count), ' Google reviews']],
  ['film',  'Legal front-window tint',             '70% VLT ceramic and carbon film, no fix-it tickets'],
  ['wrap',  'Tint, wrap, PPF and coating',         [String(data.services.length), ' services under one roof']],
  ['clock', 'Open Monday through Saturday',        S.hours_short],
];
---
<div class="statband" data-statband>
  <div class="wrap">
    <div class="statband-inner">
      {stats.map(([ic, t, sub]) => (
        <div class="stat">
          <span class="stat-ico"><Icon name={ic} /></span>
          <div>
            <b>{Array.isArray(t) ? <><span data-count={t[0]}>{t[0]}</span>{t[1]}</> : t}</b>
            <span>{Array.isArray(sub) ? <><span data-count={sub[0]}>{sub[0]}</span>{sub[1]}</> : sub}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>
