---
import data from '../../data/site.json';
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import StatBand from '../../components/StatBand.astro';
import ServiceCards from '../../components/ServiceCards.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { localBusiness, breadcrumbs } from '../../lib/seo';
const S = data.site;
const trail: [string, string][] = [['Home', '/'], ['Services', '/services/']];
---
<Base
  title="Tint, Wrap & Detailing Services in Sacramento, CA"
  description="Every service at Cali Tints in Sacramento, CA — window tinting, vinyl wraps, PPF, ceramic coating, detailing, paint correction and more. Call (916) 701-2005."
  path="/services/" active="/services/"
  schemas={[localBusiness(), breadcrumbs(trail)]}
>
  <PageHead trail={trail} h1="Tint, wrap, protection and detailing services in Sacramento"
    lede="Twelve services for the glass, the paint and the inside of the car. Every one starts the same way: a price on your vehicle before anything is touched.">
    <div class="btn-row">
      <a class="btn btn-accent" href={`tel:${S.phone_link}`} data-loc="services-head">
        <Icon name="phone" /><span>Call {S.phone_display}</span>
      </a>
      <a class="btn btn-ghost" href="/contact/#quote">Request a quote</a>
    </div>
  </PageHead>

  <StatBand />

  <section>
    <div class="wrap">
      <div class="sec-head center">
        <span class="eyebrow">The full list</span>
        <h2>Twelve things we do, one page each</h2>
        <p>Each page says what the service covers, the signs it is needed, and how the price is set.</p>
      </div>
      <div class="grid g3" data-stagger><ServiceCards /></div>
    </div>
  </section>

  <section class="bg-alt">
    <div class="wrap narrow">
      <h2>Don't see what you need?</h2>
      <p>This list covers the work that comes through the shop most often, but it is not everything. If the car has a problem that is not on this page — or you do not know what to call it — describe it and we will tell you honestly whether it is work we can take on, or who can.</p>
      <p>We work on cars, trucks, SUVs, vans, motorcycles and business fleets, and combine jobs whenever the car is already in: tint and brakes on the same visit, PPF and a coating in the same week.</p>
      <div class="btn-row">
        <a class="btn btn-dark" href={`tel:${S.phone_link}`} data-loc="services-body">
          <Icon name="phone" /><span>Call {S.phone_display}</span>
        </a>
        <a class="btn btn-outline" href="/contact/">Contact the shop</a>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>
