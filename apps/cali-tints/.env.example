# ---- Supabase (Project Settings → API) --------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# New-style publishable key (sb_publishable_...). The legacy anon JWT also works
# under NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server only. Never expose to the browser. Used for inviting users, signed
# URLs and the demo seed script.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx
# Only for `pnpm db:push` (applies missing migrations). Project Settings →
# Database → Connection string, "Session pooler" (port 5432). Never in the app.
# SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ---- App --------------------------------------------------------------------
# Public URL of the deployment (used in invite emails and email links).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Email (invoice submission) --------------------------------------------
# https://resend.com → API Keys. Without this, "Submit invoice" reports a clear
# error instead of silently doing nothing; manual "Mark as submitted" still works.
RESEND_API_KEY=re_xxx
# Must be on a domain verified in Resend.
EMAIL_FROM="Cali Tints Billing <billing@yourdomain.com>"

# ---- QuickBooks Online (optional) -------------------------------------------
# developer.intuit.com → your app → Keys & credentials. Redirect URI to register:
# ${NEXT_PUBLIC_APP_URL}/api/quickbooks/callback. Use the Development keys with
# QUICKBOOKS_ENV=sandbox against a sandbox company; Production keys + production
# for the real books. The owner then clicks Connect under Settings.
# QUICKBOOKS_CLIENT_ID=
# QUICKBOOKS_CLIENT_SECRET=
# QUICKBOOKS_ENV=production

# ---- Deposits online: Clover hosted checkout (optional) ---------------------
# Off by default: DEPOSITS_ONLINE=none means the shop takes deposits at
# drop-off and nothing below is needed. Set DEPOSITS_ONLINE=clover to let a
# customer pay the deposit on Clover's secure page (your existing merchant,
# no new fee). Merchant dashboard → Ecommerce → create a HOSTED CHECKOUT
# integration (an "Iframe" or "API only" key is refused by Clover), copy the
# private key and your merchant id; set the webhook URL to
# ${NEXT_PUBLIC_APP_URL}/api/clover/webhook?secret=<CLOVER_WEBHOOK_SECRET>.
# Test with CLOVER_ENV=sandbox and a sandbox merchant first.
# DEPOSITS_ONLINE=none
# CLOVER_ENV=sandbox
# CLOVER_MERCHANT_ID=
# CLOVER_ECOM_PRIVATE_KEY=
# CLOVER_WEBHOOK_SECRET=
# Optional: a merchant REST API token (Settings → API tokens, Payments read)
# lets the daily job reconcile a payment whose webhook never arrived.
# CLOVER_API_TOKEN=

# ---- Scheduled jobs ----------------------------------------------------------
# Protects /api/cron/* (Vercel Cron sends it as a bearer token automatically).
# /api/cron/daily runs at 7am Pacific; /api/cron/automation every five minutes
# (vercel.json; the five-minute schedule needs Vercel Pro).
# CRON_SECRET=

# ---- Reserved flags (documented, not read by any code yet) -----------------
# Texts are queued for the owner's phone (sms: links on Retail → Today); a
# paid SMS provider would plug into queue_text. AI features are not built.
# SMS_PROVIDER=none
# AI_PROVIDER=none

# ---- Plate -> VIN lookup (optional, paid, OFF) -----------------------------
# The app always looks a plate up in your own records first (free). A paid
# plate-to-VIN service can be wired in later; no vendor adapter is bundled
# until you pick one (it has to be written against that vendor's docs).
# Vehicle data only, never owner details.
# PLATE_PROVIDER=none
# PLATE_PROVIDER_KEY=

# ---- Guest preview (optional) ----------------------------------------------
# Set a long random string to enable /demo?key=<value>: a share-able link that
# opens the app with sample data and no login (nothing is saved). Leave unset
# on the real deployment. Generate one with: openssl rand -hex 24
# DEMO_ACCESS_KEY=

# ---- Demo seed (scripts/seed-demo.ts) --------------------------------------
SEED_OWNER_EMAIL=owner@demo.calitints.app
SEED_OWNER_PASSWORD=demo-owner-123
SEED_DETAILER_PASSWORD=demo-detailer-123
