# ---- Supabase (Project Settings → API) --------------------------------------
# Create a project at https://supabase.com/dashboard/sign-up
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# New-style publishable key (sb_publishable_...). The legacy anon JWT also works
# under NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server only. Never expose to the browser. Used by the job worker and admin actions.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx
# Only for `pnpm db:push` (applies missing migrations). Project Settings →
# Database → Connection string, "Session pooler" (port 5432). Never in the app.
# SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ---- App --------------------------------------------------------------------
# Public URL of the deployment (invite emails, report links). Vercel: https://vercel.com/signup
NEXT_PUBLIC_APP_URL=http://localhost:3000
# mock  = adapters serve fixtures, no network, no spend (tests, first local run)
# record = call the API and write the fixture (dev only)
# live  = call the API (production)
PROVIDER_MODE=mock
# Warn on the providers page when an audit's logged cost passes this (USD).
AUDIT_COST_BUDGET_USD=5

# ---- Inngest (audit jobs) ---------------------------------------------------
# Not needed locally: `pnpm inngest:dev` runs the dev server. In production the
# Vercel integration sets both. https://app.inngest.com/sign-up
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# ---- Anthropic (analysis, copywriting, solutions) — Phase 0, optional -------
# https://platform.claude.com → API keys. Without it the adapter reports
# not_configured in live mode; mock mode never needs it.
# ANTHROPIC_API_KEY=sk-ant-...

# ---- Google Cloud ------------------------------------------------------------
# https://console.cloud.google.com → APIs & Services → enable "Places API (New)"
# (Phase 1: resolver, ~$0.03 per Text Search) and "PageSpeed Insights API"
# (Phase 2, free; required: the keyless quota is shared and exhausted) → Credentials.
# Restrict each key to its API.
# GOOGLE_PLACES_API_KEY=
# GOOGLE_PAGESPEED_API_KEY=

# ---- DataForSEO (Phases 4–6: SERP, Labs, Backlinks, AI Optimization) --------
# https://app.dataforseo.com/register → Dashboard → API Access
# DATAFORSEO_LOGIN=
# DATAFORSEO_PASSWORD=

# ---- Yelp Places / Fusion (Phase 1: NAP source; Phase 3: full analysis) -----
# https://www.yelp.com/developers/v3/manage_app — confirm the plan licenses
# showing data to clients before going live.
# YELP_API_KEY=
