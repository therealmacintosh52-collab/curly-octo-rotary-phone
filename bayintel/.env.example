# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used for provider_cache writes, public share links and Stripe webhooks.
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI (server-only secret)
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_TECH=price_...
STRIPE_PRICE_SHOP=price_...
# Optional: a 100%-off-one-month coupon id used to redeem contributor free months
STRIPE_COUPON_FREE_MONTH=
