# Quantum Growth OS: environment variables
# Copy to .env.local (local) and set the same keys in Vercel (deployed). NEVER commit real values.
# Format per key: what it is, where to get it, [phase that first needs it].
#
# Every integration has a MODE flag. "manual" (default) = no API call; the app generates the content plus a
# step checklist for the operator. "live" = call the real API (needs the keys below).

# ---------- Supabase  [Phase 1a] ----------
# supabase.com > project > Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses row-level security. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# supabase.com > project > Settings > Database > Connection string (for migrations)
SUPABASE_DB_URL=

# ---------- Access control  [Phase 1a] ----------
# Comma-separated emails allowed into /admin
ADMIN_ALLOWED_EMAILS=
# Random 32-byte value (openssl rand -base64 32). Protects cron endpoints.
CRON_SECRET=
# Random 32-byte value (openssl rand -base64 32). Encrypts client OAuth tokens and sensitive columns (EIN etc.).
ENCRYPTION_KEY=
# Public base URLs of the two apps
NEXT_PUBLIC_ADMIN_URL=
NEXT_PUBLIC_PORTAL_URL=

# ---------- Payments: Square (recurring, cards, invoices) + Zelle (manual)  [Phase 1c] ----------
# manual = no API calls; the app shows payment links/instructions and you mark payments received by hand.
PAYMENTS_MODE=manual
# sandbox or production
SQUARE_ENVIRONMENT=sandbox
# developer.squareup.com > Applications > your app > Credentials (use Sandbox tokens until you go live)
SQUARE_ACCESS_TOKEN=
NEXT_PUBLIC_SQUARE_APP_ID=
# developer.squareup.com > Applications > your app > Locations (or Square Dashboard > Account & Settings > Business > Locations)
NEXT_PUBLIC_SQUARE_LOCATION_ID=
# developer.squareup.com > Applications > your app > Webhooks > your endpoint > Signature key
SQUARE_WEBHOOK_SIGNATURE_KEY=
# Zelle has no API. This is only the email/phone clients send to, shown on the Zelle pay screen. Use the one registered for your business Zelle.
ZELLE_PAYEE_EMAIL_OR_PHONE=

# ---------- Email (reminders, pay links, reports)  [Phase 1d] ----------
# Not named in the spec; Resend chosen as default. Remove or swap if you prefer another provider.
EMAIL_MODE=manual
# resend.com > API Keys
RESEND_API_KEY=
EMAIL_FROM=

# ---------- Twilio  [Phase 1d texts; Phase 2 ISV/10DLC; Phase 7 text-back]----------
SMS_MODE=manual
# console.twilio.com > Account Info
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Messaging service or number used for operator-to-client texts
TWILIO_FROM_NUMBER=

# ---------- Retell (AI receptionist)  [Phase 7] ----------
RETELL_MODE=manual
# app.retellai.com > API Keys
RETELL_API_KEY=

# ---------- BrightLocal (citations)  [Phase 5] ----------
CITATIONS_MODE=manual
# brightlocal.com > Account > API (API key and secret)
BRIGHTLOCAL_API_KEY=
BRIGHTLOCAL_API_SECRET=

# ---------- Local Falcon (geo-grid rank tracking)  [Phase 8] ----------
RANKS_MODE=manual
# localfalcon.com > Account > API
LOCAL_FALCON_API_KEY=

# ---------- Anthropic (AI drafting)  [Phase 3 onward] ----------
AI_MODE=manual
# console.anthropic.com > API Keys
ANTHROPIC_API_KEY=

# ---------- Google  [Phase 3 audit; Phase 5 GBP; Phase 8 reports] ----------
GOOGLE_MODE=manual
# console.cloud.google.com > APIs & Services > Credentials (OAuth client for GBP, GA4, Search Console)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Same console > enable "PageSpeed Insights API" > API key
GOOGLE_PAGESPEED_API_KEY=
# Business Profile APIs need access approval from Google (apply early); manual mode until then.

# ---------- Meta (Facebook/Instagram posting, ads)  [Phase 6; Phase 10 ads] ----------
META_MODE=manual
# developers.facebook.com > your app > Settings > Basic
META_APP_ID=
META_APP_SECRET=

# ---------- Cloudflare Pages (client site hosting)  [Phase 4] ----------
HOSTING_MODE=manual
# dash.cloudflare.com > My Profile > API Tokens (Pages edit permission)
CLOUDFLARE_API_TOKEN=
# dash.cloudflare.com > any domain > right sidebar > Account ID
CLOUDFLARE_ACCOUNT_ID=

# ---------- CRM (HubSpot free tier default)  [Phase 7] ----------
CRM_MODE=manual
# HubSpot > Settings > Integrations > Private Apps. Created in the CLIENT's HubSpot account; stored encrypted per client, not here.
# (No global key. Listed so the flag is not missed.)
