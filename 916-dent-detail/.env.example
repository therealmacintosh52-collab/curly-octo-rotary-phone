# 916 Dent & Detail — environment variables for ALL phases.
# Copy to .env.local and fill in. Every value is intentionally empty: the app builds and runs
# with zero keys (each integration falls back to a mock/demo mode). Never commit .env.local.
# Phase in [brackets] = when the key starts being read.

# ---- Site ----------------------------------------------------------------------------------
# [P1] Public origin used for canonical URLs, OG images, sitemap. e.g. https://916dentdetail.com
NEXT_PUBLIC_SITE_URL=

# ---- Business config -----------------------------------------------------------------------
# [P2] Travel-fee origin ZIP. Empty = config default 95624 (src/config/site.ts).
BASE_ZIP=
# [P3] Comma-separated owner logins allowed into /admin.
ADMIN_EMAILS=
# [P4] Phones (E.164, comma-separated) that receive escalations / missed-call summaries.
OWNER_ALERT_PHONES=

# ---- Supabase (Postgres, Auth, Storage, RLS) [P2/P3] ----------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS: never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Storage bucket for job / quote photos.
SUPABASE_PHOTOS_BUCKET=

# ---- Stripe (deposits, invoices, memberships, dealer net terms) [P2/P3/P5] -----------------
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Twilio (SMS, missed-call text-back, bot channel) [P2/P4] ------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Either a sending number (E.164) or a Messaging Service SID.
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# ---- Resend (transactional email) [P2] -----------------------------------------------------
RESEND_API_KEY=
# e.g. "916 Dent & Detail <bookings@yourdomain.com>" (domain must be verified in Resend)
EMAIL_FROM=
OWNER_ALERT_EMAILS=

# ---- Anthropic (916 Concierge assistant + photo quote) [P2/P4] -----------------------------
ANTHROPIC_API_KEY=
# Model per SPEC; empty = claude-sonnet-5-5
ANTHROPIC_MODEL=
# Hard cost cap per conversation in USD (guardrail). Empty = code default.
CONCIERGE_MAX_COST_USD=

# ---- Google Calendar sync (optional) [P2] --------------------------------------------------
# Service account with access to each technician calendar.
GOOGLE_CALENDAR_CLIENT_EMAIL=
GOOGLE_CALENDAR_PRIVATE_KEY=
# Comma-separated tech=calendarId pairs, e.g. alex=abc@group.calendar.google.com
GOOGLE_CALENDAR_IDS=

# ---- Analytics & ads [P6] ------------------------------------------------------------------
# GA4 (gtag) + Measurement Protocol secret for server-side events
NEXT_PUBLIC_GA4_ID=
GA4_API_SECRET=
# Meta Pixel + Conversions API
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=
# Google Ads conversion tracking
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LABEL_QUOTE=
NEXT_PUBLIC_GOOGLE_ADS_LABEL_BOOKING=
NEXT_PUBLIC_GOOGLE_ADS_LABEL_CALL=
# Vercel Analytics needs no key (enabled in the Vercel dashboard).

# ---- Local tooling (not used at runtime) ---------------------------------------------------
# Chrome for `node scripts/lh.mjs` (Lighthouse). Playwright browsers dir for shots/axe scripts.
CHROME_PATH=
PLAYWRIGHT_BROWSERS_PATH=

# ---- Phase 6 additions ---------------------------------------------------------------------
# NEXT_PUBLIC_GADS_ID (and _GADS_LABEL_QUOTE/_BOOKING/_CALL) work as aliases of the NEXT_PUBLIC_GOOGLE_ADS_* names above.
# [OWNER] Privacy policy URL: the consent banner links to it once set (banner only appears when a tracker ID is set).
NEXT_PUBLIC_PRIVACY_URL=
# Set to 1 to load Vercel Analytics on a non-Vercel host (on Vercel it is on automatically).
NEXT_PUBLIC_VERCEL_ANALYTICS=
# Optional: pin the Meta Graph API version used by the Conversions API helper (default v21.0).
META_GRAPH_VERSION=

# ---- Phase 2 booking engine additions -----------------------------------------------------
# Random 32+ char string that signs /booking/[token] links. Required once Supabase is configured.
BOOKING_TOKEN_SECRET=
# Secures /api/cron/dispatch (Vercel Cron sends it as "Authorization: Bearer ..."). Required in production.
CRON_SECRET=
# Optional: shared rate limiting across serverless instances (Upstash Redis REST).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Which proxy header carries the client IP (rate limits key on it; SECURITY.md O-02). vercel | hops:N | none.
# Leave empty on Vercel (auto). Self-hosting behind ONE proxy that appends to X-Forwarded-For: hops:1 (also the production default off Vercel).
# `none` ignores forwarding headers (all clients share one bucket): only when nothing trustworthy identifies the client.
TRUST_PROXY=
# Content-Security-Policy: enforce (default) | report-only | off. Violations go to /api/csp-report (logged, not stored).
CSP_MODE=
# Staff (owner/admin) session length in days, 1-14, default 3. Technicians always get 7.
ADMIN_SESSION_DAYS=
# Optional (mock store only): persist the in-memory demo database to this JSON file between restarts.
MOCK_DB_FILE=

# ---- Phase 4: 916 Concierge ---------------------------------------------------------------
# (ANTHROPIC_API_KEY, ANTHROPIC_MODEL, CONCIERGE_MAX_COST_USD, OWNER_ALERT_PHONES and the TWILIO_* keys are listed above.)
# Public origin Twilio calls, e.g. https://916dentdetail.com. Signature validation hashes this exact URL. Falls back to NEXT_PUBLIC_SITE_URL.
TWILIO_WEBHOOK_BASE_URL=
# async (default when Twilio is live): answer Twilio at once, reply through the sms lib. twiml: reply inside the webhook response.
SMS_REPLY_MODE=
# 1 = also send our own STOP/START/HELP replies (only if Twilio's opt-out replies are turned off in the console).
CONCIERGE_SMS_KEYWORD_REPLIES=
# Run the live-model scenarios: BOT_LIVE=1 ANTHROPIC_API_KEY=... npx vitest run tests/bot/scenarios.test.ts
BOT_LIVE=

# ---- Phase 3 (CRM + /admin) additions ------------------------------------------------------
# Secret that signs the admin session cookie (16+ chars). Falls back to BOOKING_TOKEN_SECRET. Required in production.
ADMIN_SESSION_SECRET=
# Set to 1 to allow the clearly-labelled DEMO login in a production build WITHOUT a database (demos only). Ignored when Supabase is configured.
ADMIN_DEMO_LOGIN=
# Second Stripe webhook endpoint /api/admin/stripe/webhook (pay links + memberships). Falls back to STRIPE_WEBHOOK_SECRET.
# Events: checkout.session.completed, customer.subscription.updated, customer.subscription.deleted, invoice.paid, invoice.payment_failed
STRIPE_WEBHOOK_SECRET_ADMIN=
# Stripe Terminal location (enables the card-reader server routes; the reader UI is not built yet).
STRIPE_TERMINAL_LOCATION_ID=

# ---- Dealer portal [P5] --------------------------------------------------------------------
# Signs the dealer session cookie (random 32+ chars). Falls back to BOOKING_TOKEN_SECRET. Required when Supabase is configured.
DEALER_SESSION_SECRET=
# Third Stripe webhook endpoint /api/dealers/stripe-webhook (dealer net-terms invoices). Events: invoice.paid, invoice.voided. Falls back to STRIPE_WEBHOOK_SECRET.
STRIPE_DEALER_WEBHOOK_SECRET=

# ---- Phase 8 additions --------------------------------------------------------------------
# Days a chat/text transcript is kept after its last message before the daily retention job deletes it (min 7, default 180).
CONCIERGE_RETENTION_DAYS=
# Demo dealer sign-in (email only, NO password). Off in production and ignored whenever Supabase is configured. NEVER set on the real site.
DEALERS_DEMO_LOGIN=
# Tooling only (not used at runtime): Playwright e2e server port (default 3210), `npm run verify` axe server port (default 3211).
E2E_PORT=
VERIFY_AXE_PORT=
