    "next": "^16.4.1",
    "next-mdx-remote": "^6.0.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.33.0",
    "stripe": "^23.0.0",
    "twilio": "^6.2.0",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=20.9"
