{
  "name": "916-dent-detail",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/check-similarity.mjs --quiet",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "media": "node scripts/media.mjs",
    "check:owner": "node scripts/check-owner.mjs",
    "verify": "node scripts/verify.mjs",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "check:content": "node scripts/check-similarity.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "leave-behind": "node scripts/leave-behind.mjs",
    "test:bot": "vitest run tests/bot",
    "test:e2e": "playwright test",
    "test:e2e:mobile": "playwright test --project=mobile",
    "axe": "node scripts/axe.mjs",
    "verify:quick": "npm run typecheck && npm run lint && npm run build",
    "seed": "node --experimental-transform-types --disable-warning=ExperimentalWarning --import ./scripts/lib/register-alias.mjs scripts/seed.mjs",
    "setup:admin": "node --experimental-transform-types --disable-warning=ExperimentalWarning --import ./scripts/lib/register-alias.mjs scripts/setup-admin.mjs",
    "doctor": "node scripts/doctor.mjs",
    "deploy": "node scripts/deploy.mjs",
    "lhci": "node scripts/lhci.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.10",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.1",
    "lighthouse": "^13.5.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9",
    "vitest": "^5.0.4",
    "wawoff2": "^2.0.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@pdf-lib/fontkit": "^1.1.1",
