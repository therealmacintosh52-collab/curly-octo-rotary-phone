{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/e2e-server.mjs --port=3212",
      "startServerReadyPattern": "Ready",
      "startServerReadyTimeout": 600000,
      "url": [
        "http://localhost:3212/",
        "http://localhost:3212/services/paintless-dent-repair",
        "http://localhost:3212/areas/folsom",
        "http://localhost:3212/book",
        "http://localhost:3212/dealers",
        "http://localhost:3212/blog/can-every-dent-be-fixed-without-paint"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "mobile",
        "onlyCategories": ["performance", "accessibility", "best-practices", "seo"],
        "chromeFlags": "--headless=new --no-sandbox --disable-gpu"
      }
    },
    "assert": {
      "aggregationMethod": "median",
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "total-blocking-time": ["error", { "maxNumericValue": 300 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
